generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String            @id @default(cuid())
  email            String            @unique
  password         String
  name             String?
  role             String            @default("USER")
  purchaseStatus   String            @default("UNPAID")
  stripeCustomerId String?
  stripeSubscriptionId String?
  subscriptionStatus   String        @default("none")
  tags             String?
  adminNotes       String?
  referralCode     String?           @unique
  referralCount    Int               @default(0)
  referredBy       String?
  cohortId         String?
  utmSource        String?
  utmMedium        String?
  utmCampaign      String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  profile          Profile?
  progress         Progress[]
  practiceSessions PracticeSession[]
  userAchievements UserAchievement[]
  coachMessages    CoachMessage[]
  feedback         Feedback[]
  supportTickets   SupportTicket[]
  lessonComments   LessonComment[]
  couponRedemptions CouponRedemption[]
  adminLogs        AdminLog[]
  partnersAsUser      AccountabilityPartner[]  @relation("partnerUser")
  partnersAsPartner   AccountabilityPartner[]  @relation("partnerMatch")
  passwordResetTokens PasswordResetToken[]
  cohort           Cohort?           @relation(fields: [cohortId], references: [id])
  funnelEvents     FunnelEvent[]
  giftCodesRedeemed GiftCode[]       @relation("giftRedeemer")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Profile {
  id               String    @id @default(cuid())
  userId           String    @unique
  user             User      @relation(fields: [userId], references: [id])
  instrument       String?
  experienceMonths Int?
  tabComfort       Int?
  hasBasicChords   Boolean?
  hasLearnedSolo   Boolean?
  pickingLevel     Int?
  hammerOnLevel    Int?
  pullOffLevel     Int?
  slideLevel       Int?
  bendLevel        Int?
  vibratoLevel     Int?
  pentatonicLevel  Int?
  styles           String?
  practiceMinutes  Int?
  currentDay             Int       @default(1)
  totalXP                Int       @default(0)
  streak                 Int       @default(0)
  lastPracticeDate       DateTime?
  streakFreezes          Int       @default(1)
  bestStreak             Int       @default(0)
  weeklyGoalDays              Int       @default(5)
  leaderboardOptIn            Boolean   @default(false)
  avatarUrl                   String?
  dailyChallengeStreak        Int       @default(0)
  lastDailyChallengeDate      DateTime?
  pomodoroSessions            Int       @default(0)
  adaptivePath                String?
  weeklyPlan                  String?
  weeklyPlanGeneratedAt       DateTime?
  soloStyle                   String?
  guitarHero                  String?
  soloVibe                    String?
  customSolo                  String?
  soloGeneratedAt             DateTime?
  soloCompleted               Boolean   @default(false)
  soloCompletedAt             DateTime?
  graduateNote                String?
}

model Progress {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id])
  day            Int
  completed      Boolean   @default(false)
  completedAt    DateTime?
  difficulty     String?
  difficultAreas String?
  rating         Int?
  notes          String?
  nextReviewAt   DateTime?
  reviewCount    Int       @default(0)
  easeFactor     Float     @default(2.5)
  createdAt      DateTime  @default(now())

  @@unique([userId, day])
}

model PracticeSession {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  day        Int
  duration   Int
  difficulty String?
  createdAt  DateTime @default(now())
}

model Achievement {
  id               String            @id @default(cuid())
  key              String            @unique
  name             String
  description      String
  xpReward         Int               @default(0)
  userAchievements UserAchievement[]
}

model UserAchievement {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id])
  unlockedAt    DateTime    @default(now())

  @@unique([userId, achievementId])
}

model CoachMessage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  role      String
  content   String
  createdAt DateTime @default(now())
}

model AudioAsset {
  id        String   @id @default(cuid())
  type      String
  label     String
  url       String
  day       Int?
  section   Int?
  speed     String?
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Feedback {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  day       Int?
  rating    Int?
  comment   String?
  type      String?
  createdAt DateTime @default(now())
}

model SupportTicket {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  subject   String
  message   String
  status    String   @default("open")
  reply     String?
  repliedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LessonComment {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  day       Int
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  message   String
  type      String   @default("info")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AdminLog {
  id        String   @id @default(cuid())
  adminId   String
  admin     User     @relation(fields: [adminId], references: [id])
  action    String
  target    String?
  details   String?
  createdAt DateTime @default(now())
}

model CouponCode {
  id          String             @id @default(cuid())
  code        String             @unique
  discountPct Int
  usageLimit  Int?
  usedCount   Int                @default(0)
  expiresAt   DateTime?
  active      Boolean            @default(true)
  createdAt   DateTime           @default(now())
  redemptions CouponRedemption[]
}

model CouponRedemption {
  id        String     @id @default(cuid())
  couponId  String
  coupon    CouponCode @relation(fields: [couponId], references: [id])
  userId    String
  user      User       @relation(fields: [userId], references: [id])
  createdAt DateTime   @default(now())

  @@unique([couponId, userId])
}

model AccountabilityPartner {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation("partnerUser", fields: [userId], references: [id])
  partnerId String
  partner   User     @relation("partnerMatch", fields: [partnerId], references: [id])
  status    String   @default("pending")
  createdAt DateTime @default(now())

  @@unique([userId, partnerId])
}

model Cohort {
  id        String   @id @default(cuid())
  name      String
  startDate DateTime
  users     User[]
  createdAt DateTime @default(now())
}

model BlogPost {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  excerpt     String
  content     String
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model FunnelEvent {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  event       String
  page        String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  metadata    String?
  createdAt   DateTime @default(now())
}

model GiftCode {
  id                    String    @id @default(cuid())
  code                  String    @unique
  fromName              String?
  fromEmail             String
  toEmail               String?
  message               String?
  redeemed              Boolean   @default(false)
  redeemedAt            DateTime?
  redeemedById          String?
  redeemedBy            User?     @relation("giftRedeemer", fields: [redeemedById], references: [id])
  stripePaymentIntentId String?
  createdAt             DateTime  @default(now())
}
